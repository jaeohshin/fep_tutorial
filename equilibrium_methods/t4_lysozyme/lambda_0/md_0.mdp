integrator              = md
nsteps = 10000000
dt                      = 0.002
nstlist                 = 20
cutoff-scheme           = Verlet
coulombtype             = PME
rcoulomb                = 1.1       ; NPT 최적화 결과 반영
rvdw                    = 1.1
; 온도 제어
tcoupl                  = V-rescale
tc-grps                 = Protein Non-Protein
tau-t                   = 0.1     0.1
ref-t                   = 300     300
; 압력 제어
pcoupl                  = Parrinello-Rahman
pcoupltype              = isotropic
tau-p                   = 2.0
compressibility         = 4.5e-5
ref-p                   = 1.0
; 속도 생성 안 함 (NPT에서 이어받음)
gen_vel                 = no
; FEP 설정 (동일 유지)
free-energy              = yes
init-lambda = 0
sc-alpha                 = 0.5
sc-power                 = 1
sc-sigma                 = 0.5
; 출력 제어 (용량 관리를 위해 적절히 조절)
nstxout-compressed      = 5000      ; 10 ps마다 좌표 저장
nstenergy               = 5000      ; 10 ps마다 에너지 저장
