integrator      = steep
emtol           = 100.0
emstep          = 0.01
nsteps          = 50000
nstlist         = 1
cutoff-scheme   = Verlet
ns_type         = grid
coulombtype     = PME
rcoulomb        = 1.0
rvdw            = 1.0
pbc             = xyz

; Free energy parameters
free-energy      = yes
init-lambda      = 0
sc-alpha         = 0.5
sc-power         = 1
sc-sigma         = 0.3
