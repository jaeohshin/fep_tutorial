define                  = -DPOSRES
integrator              = md
nsteps                  = 50000     ; 100 ps
dt                      = 0.002
nstlist                 = 20
cutoff-scheme           = Verlet
coulombtype             = PME
rcoulomb                = 1.0
rvdw                    = 1.0
; 온도 제어
tcoupl                  = V-rescale
tc-grps                 = Protein Non-Protein
tau-t                   = 0.1     0.1
ref-t                   = 300     300
; 압력 제어 (NPT 핵심)
pcoupl                  = Parrinello-Rahman
pcoupltype              = isotropic
tau-p                   = 2.0
compressibility         = 4.5e-5
ref-p                   = 1.0
; 속도 생성은 NVT에서 했으므로 유지
gen_vel                 = no
; FEP 전용 설정 (동일 유지)
free-energy              = yes
init-lambda              = 0
sc-alpha                 = 0.5
sc-power                 = 1
sc-sigma                 = 0.5
